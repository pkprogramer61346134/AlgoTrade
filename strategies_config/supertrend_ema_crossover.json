{
  "id": "supertrend_ema_crossover",
  "name": "Supertrend + EMA 9/20 Crossover Strategy",
  "enabled": true,
  "description": "Trend-following strategy combining Supertrend (10, 3) direction with EMA 9 and EMA 20 crossovers.",
  "author": "AlgoTrade Engine",
  "timeframe": "5",
  "maxTradesPerDay": 5,
  "riskRewardRatio": 2.0,
  "indicators": {
    "emaFastPeriod": 9,
    "emaSlowPeriod": 20,
    "supertrendPeriod": 10,
    "supertrendMultiplier": 3,
    "rsiPeriod": 14
  },
  "rules": {
    "buy": [
      { "field": "supertrendDirection", "operator": "==", "target": 1 },
      { "field": "emaFast", "operator": ">", "target": "emaSlow" },
      { "field": "rsi", "operator": ">", "target": 50 }
    ],
    "sell": [
      { "field": "supertrendDirection", "operator": "==", "target": -1 },
      { "field": "emaFast", "operator": "<", "target": "emaSlow" },
      { "field": "rsi", "operator": "<", "target": 50 }
    ]
  },
  "stopLoss": {
    "type": "ATR_MULTIPLE",
    "multiplier": 1.5
  },
  "target": {
    "type": "RISK_REWARD",
    "multiplier": 2.0
  }
}
