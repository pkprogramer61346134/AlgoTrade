{
  "id": "orb_intraday_active",
  "name": "15-Min ORB Active Intraday Strategy (Daily Quality Trades)",
  "enabled": true,
  "timeframe": "5",
  "maxTradesPerDay": 4,
  "riskRewardRatio": 3.0,
  "indicators": {
    "orbMinutes": 15,
    "rsiPeriod": 14,
    "emaTrendPeriod": 50
  },
  "rules": {
    "buy": [
      {
        "field": "high",
        "operator": ">=",
        "target": "orbHigh"
      },
      {
        "field": "rvol",
        "operator": ">=",
        "target": 1.2
      },
      {
        "field": "rsi",
        "operator": ">",
        "target": 52
      },
      {
        "field": "close",
        "operator": ">",
        "target": "ema50"
      }
    ],
    "sell": [
      {
        "field": "low",
        "operator": "<=",
        "target": "orbLow"
      },
      {
        "field": "rvol",
        "operator": ">=",
        "target": 1.2
      },
      {
        "field": "rsi",
        "operator": "<",
        "target": 48
      },
      {
        "field": "close",
        "operator": "<",
        "target": "ema50"
      }
    ]
  },
  "stopLoss": {
    "type": "ORB_LEVEL",
    "fallbackATRMultiplier": 1.2
  },
  "target": {
    "type": "RISK_REWARD",
    "multiplier": 3.0
  }
}