      { "field": "rsi", "operator": ">", "target": 50 },
      { "field": "pcr", "operator": ">=", "target": 1.0 }
    ],
    "sell": [
      { "field": "close", "operator": "<", "target": "orbLow" },
      { "field": "close", "operator": "<", "target": "ema200" },
      { "field": "rvol", "operator": ">=", "target": 2.0 },
      { "field": "rsi", "operator": "<", "target": 50 },
      { "field": "pcr", "operator": "<=", "target": 0.8 }
    ]
  },
  "stopLoss": {
    "type": "ORB_LEVEL",
    "fallbackATRMultiplier": 1.2
  },
  "target": {
    "type": "RISK_REWARD",
    "multiplier": 1.5
  }
}
